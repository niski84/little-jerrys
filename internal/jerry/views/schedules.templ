package views

import (
	"strconv"
	"strings"

	"github.com/niski84/sienfeld_smash_deck/internal/schedule"
)

type SchedulesVM struct {
	Schedules          []schedule.Schedule
	CurrentMode        string // "playback" | "off-hours"
	FanArtEnabled      bool
	FanArtSecsPerImage int
	FanArtCount        int
	AddError           string
	Locked             bool
	SavedMessage       string

	// Secondary HDMI slideshow (chromium kiosk on HDMI-1).
	SlideshowEnabled  bool
	SlideshowLayout   int // 1, 4, or 16
	SlideshowSecsPer  int
	SlideshowCount    int // catalog size (informational)
}

templ Schedules(vm SchedulesVM) {
	@Layout("Little Jerry's — Hours & Schedules", schedulesBody(vm))
}

templ schedulesBody(vm SchedulesVM) {
	<div class="grid grid-cols-1 gap-6">
		<section class="rounded-2xl border border-zinc-200 bg-white/85 p-8 dark:border-white/10 dark:bg-zinc-900/50">
			<div class="flex items-baseline justify-between">
				<div>
					<p class="font-mono text-xs uppercase tracking-[0.2em] text-amber-500 dark:text-amber-400">Hours of Operation</p>
					<h1 class="mt-2 text-2xl font-bold">Service schedule</h1>
				</div>
				<div class="rounded-full px-3 py-1 text-xs font-mono" data-testid="current-mode">
					if vm.CurrentMode == "off-hours" {
						<span class="rounded-full bg-zinc-200 px-3 py-1 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">off-hours</span>
					} else {
						<span class="rounded-full bg-emerald-200 px-3 py-1 text-emerald-900 dark:bg-emerald-500/20 dark:text-emerald-300">on the air</span>
					}
				</div>
			</div>
			<p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">
				Add one window per service period. With no entries, the appliance plays
				24/7. "Pauses" between services are just gaps between two entries
				(e.g. Breakfast 7&ndash;11:30, then Dinner 5&ndash;9 — between is off-hours).
			</p>

			if vm.SavedMessage != "" {
				<div class="mt-4 rounded-lg border border-emerald-500/40 bg-emerald-50 px-4 py-2 text-sm text-emerald-800 dark:bg-emerald-950/30 dark:text-emerald-200" data-testid="schedule-saved">{ vm.SavedMessage }</div>
			}

			<div class="mt-6 space-y-2" data-testid="schedule-list">
				if len(vm.Schedules) == 0 {
					<p class="rounded-lg border border-dashed border-zinc-300 px-4 py-6 text-center text-sm text-zinc-500 dark:border-white/10 dark:text-zinc-500" data-testid="no-schedules">
						No schedules yet — the appliance is always on. Add one below to enable hours of operation.
					</p>
				}
				for _, s := range vm.Schedules {
					<div class="flex flex-wrap items-center gap-3 rounded-lg border border-zinc-200 bg-white px-4 py-3 dark:border-white/10 dark:bg-zinc-950/40" data-testid={ "schedule-row-" + s.ID }>
						<form method="POST" action="/schedules/toggle" class="inline-flex">
							<input type="hidden" name="id" value={ s.ID }/>
							if s.Enabled {
								<button class="btn btn-sm" disabled?={ vm.Locked } data-testid={ "schedule-disable-" + s.ID }>Disable</button>
							} else {
								<button class="btn btn-sm btn-warning" disabled?={ vm.Locked } data-testid={ "schedule-enable-" + s.ID }>Enable</button>
							}
						</form>
						<div class="min-w-0 flex-1">
							<p class="truncate font-semibold">{ s.Name }</p>
							<p class="font-mono text-xs text-zinc-500 dark:text-zinc-400">
								{ daysLabel(s.Days) } · { s.StartTime } – { s.EndTime }
								if !s.Enabled {
									<span class="ml-2 rounded bg-zinc-200 px-2 py-0.5 text-[10px] uppercase tracking-wide text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400">disabled</span>
								}
							</p>
						</div>
						<form method="POST" action="/schedules/delete" class="inline-flex">
							<input type="hidden" name="id" value={ s.ID }/>
							<button class="btn btn-ghost btn-sm" disabled?={ vm.Locked } data-testid={ "schedule-delete-" + s.ID }>Delete</button>
						</form>
					</div>
				}
			</div>
		</section>

		<section class="rounded-2xl border border-zinc-200 bg-white/85 p-8 dark:border-white/10 dark:bg-zinc-900/50">
			<h2 class="text-xl font-bold">Add a service window</h2>
			if vm.AddError != "" {
				<div class="mt-3 rounded-lg border border-rose-500/40 bg-rose-50 px-4 py-2 text-sm text-rose-800 dark:bg-rose-950/40 dark:text-rose-200" data-testid="schedule-add-error">{ vm.AddError }</div>
			}
			<form method="POST" action="/schedules/add" class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2" data-testid="schedule-add-form">
				<label class="md:col-span-2">
					<span class="block text-xs uppercase tracking-wide text-zinc-500 dark:text-zinc-400">Name</span>
					<input
						name="name" type="text" required maxlength="40"
						placeholder="Breakfast service"
						disabled?={ vm.Locked }
						data-testid="schedule-name"
						class="mt-1 w-full rounded-md border border-zinc-300 bg-white px-3 py-2 text-sm dark:border-white/10 dark:bg-zinc-950"
					/>
				</label>
				<label>
					<span class="block text-xs uppercase tracking-wide text-zinc-500 dark:text-zinc-400">Start time</span>
					<input
						name="start_time" type="time" required value="07:00"
						disabled?={ vm.Locked }
						data-testid="schedule-start"
						class="mt-1 w-full rounded-md border border-zinc-300 bg-white px-3 py-2 font-mono text-sm dark:border-white/10 dark:bg-zinc-950"
					/>
				</label>
				<label>
					<span class="block text-xs uppercase tracking-wide text-zinc-500 dark:text-zinc-400">End time</span>
					<input
						name="end_time" type="time" required value="11:30"
						disabled?={ vm.Locked }
						data-testid="schedule-end"
						class="mt-1 w-full rounded-md border border-zinc-300 bg-white px-3 py-2 font-mono text-sm dark:border-white/10 dark:bg-zinc-950"
					/>
				</label>
				<div class="md:col-span-2">
					<span class="block text-xs uppercase tracking-wide text-zinc-500 dark:text-zinc-400">Days of week</span>
					<div class="mt-2 flex flex-wrap gap-2" data-testid="schedule-days">
						for i, label := range schedule.DayLabels {
							<label class="inline-flex items-center gap-1 rounded-md border border-zinc-300 bg-white px-3 py-1 text-sm dark:border-white/10 dark:bg-zinc-950">
								<input type="checkbox" name="days" value={ strconv.Itoa(i) } checked?={ defaultDayChecked(i) } class="h-4 w-4"/>
								<span>{ label }</span>
							</label>
						}
					</div>
				</div>
				<div class="md:col-span-2">
					<button class="btn btn-primary" disabled?={ vm.Locked } data-testid="schedule-add-submit">Add schedule</button>
				</div>
			</form>
		</section>

		<section class="rounded-2xl border border-zinc-200 bg-white/85 p-8 dark:border-white/10 dark:bg-zinc-900/50">
			<p class="font-mono text-xs uppercase tracking-[0.2em] text-amber-500 dark:text-amber-400">Secondary HDMI</p>
			<h2 class="mt-2 text-xl font-bold">Slideshow on HDMI-1</h2>
			<p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">
				The Pi's second HDMI output runs an independent slideshow loaded by chromium kiosk.
				Pulls from { strconv.Itoa(vm.SlideshowCount) } embedded images at <code class="text-amber-500 dark:text-amber-300">/static/img/clipart/</code>.
				True-random — every image plays before any repeats.
			</p>
			<form method="POST" action="/schedules/slideshow" class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-3" data-testid="slideshow-form">
				<label class="md:col-span-3 flex items-center gap-3 rounded-lg border border-zinc-200 bg-zinc-50 px-4 py-3 dark:border-white/10 dark:bg-zinc-950/40">
					<input type="checkbox" name="enabled" value="1" checked?={ vm.SlideshowEnabled } disabled?={ vm.Locked } data-testid="slideshow-enabled" class="h-5 w-5"/>
					<span class="text-sm">Enable HDMI-1 slideshow</span>
				</label>
				<div>
					<span class="block text-xs uppercase tracking-wide text-zinc-500 dark:text-zinc-400">Layout</span>
					<div class="mt-2 flex gap-2" data-testid="slideshow-layout">
						<label class="inline-flex items-center gap-1 rounded-md border border-zinc-300 bg-white px-3 py-2 text-sm dark:border-white/10 dark:bg-zinc-950">
							<input type="radio" name="layout" value="1" checked?={ vm.SlideshowLayout == 1 } disabled?={ vm.Locked }/>
							<span>1 image</span>
						</label>
						<label class="inline-flex items-center gap-1 rounded-md border border-zinc-300 bg-white px-3 py-2 text-sm dark:border-white/10 dark:bg-zinc-950">
							<input type="radio" name="layout" value="4" checked?={ vm.SlideshowLayout == 4 } disabled?={ vm.Locked }/>
							<span>2×2 (4)</span>
						</label>
						<label class="inline-flex items-center gap-1 rounded-md border border-zinc-300 bg-white px-3 py-2 text-sm dark:border-white/10 dark:bg-zinc-950">
							<input type="radio" name="layout" value="16" checked?={ vm.SlideshowLayout == 16 } disabled?={ vm.Locked }/>
							<span>4×4 (16)</span>
						</label>
					</div>
				</div>
				<div>
					<label>
						<span class="block text-xs uppercase tracking-wide text-zinc-500 dark:text-zinc-400">Seconds per cycle</span>
						<input
							type="number" min="3" max="120" name="secs_per"
							value={ strconv.Itoa(vm.SlideshowSecsPer) }
							disabled?={ vm.Locked }
							data-testid="slideshow-secs"
							class="mt-1 w-32 rounded-md border border-zinc-300 bg-white px-3 py-2 font-mono text-sm dark:border-white/10 dark:bg-zinc-950"
						/>
					</label>
				</div>
				<div class="md:col-span-3 flex items-center gap-3">
					<button class="btn btn-primary" disabled?={ vm.Locked } data-testid="slideshow-save">Save slideshow settings</button>
					<a href="/slideshow" target="_blank" class="text-sm text-amber-600 hover:underline dark:text-amber-400">Preview in new tab →</a>
				</div>
			</form>
		</section>

		<section class="rounded-2xl border border-zinc-200 bg-white/85 p-8 dark:border-white/10 dark:bg-zinc-900/50">
			<h2 class="text-xl font-bold">Off-hours: fan-art slideshow</h2>
			<p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">
				When no schedule is active, the TV cycles through the { strconv.Itoa(vm.FanArtCount) } Seinfeld fan-art images baked into the binary.
			</p>
			<form method="POST" action="/schedules/fan-art" class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2">
				<label class="flex items-center gap-3 rounded-lg border border-zinc-200 bg-zinc-50 px-4 py-3 dark:border-white/10 dark:bg-zinc-950/40">
					<input type="checkbox" name="enabled" value="1" checked?={ vm.FanArtEnabled } disabled?={ vm.Locked } data-testid="fan-art-enabled" class="h-5 w-5"/>
					<span class="text-sm">Slideshow enabled during off-hours</span>
				</label>
				<label>
					<span class="block text-xs uppercase tracking-wide text-zinc-500 dark:text-zinc-400">Seconds per image</span>
					<input
						type="number" min="3" max="60" name="secs_per"
						value={ strconv.Itoa(vm.FanArtSecsPerImage) }
						disabled?={ vm.Locked }
						data-testid="fan-art-secs"
						class="mt-1 w-32 rounded-md border border-zinc-300 bg-white px-3 py-2 font-mono text-sm dark:border-white/10 dark:bg-zinc-950"
					/>
				</label>
				<div class="md:col-span-2">
					<button class="btn btn-primary" disabled?={ vm.Locked } data-testid="fan-art-save">Save fan-art settings</button>
				</div>
			</form>
		</section>
	</div>
}

func daysLabel(days []int) string {
	if len(days) == 7 {
		return "Every day"
	}
	out := make([]string, 0, len(days))
	for _, d := range days {
		if d >= 0 && d < len(schedule.DayLabels) {
			out = append(out, schedule.DayLabels[d])
		}
	}
	return strings.Join(out, " · ")
}

// defaultDayChecked pre-checks Mon-Fri on the add form (most common case).
func defaultDayChecked(day int) bool {
	return day >= 1 && day <= 5
}
