package views

import "strings"
import "github.com/niski84/little-jerrys/internal/library"

type SettingsVM struct {
	LoopGuardThreshold int
	WebhookOutbound    []string
	QuietModeEnabled   bool
	QuietStart         string
	QuietEnd           string
	Locked             bool
	SavedMessage       string
	Library            *library.Status
}

templ Settings(vm SettingsVM) {
	@Layout("Little Jerry's — Settings", settingsBody(vm))
}

templ settingsBody(vm SettingsVM) {
	<div class="grid grid-cols-1 gap-6">
		if vm.Library != nil {
			@LibraryStatus(*vm.Library)
			<script>
				(function () {
					var pending = false;
					setInterval(async function () {
						if (pending || document.hidden) return;
						pending = true;
						try {
							var response = await fetch('/settings/library', {cache: 'no-store', credentials: 'same-origin'});
							if (!response.ok || response.redirected) throw new Error('Status unavailable');
							var old = document.getElementById('library-status');
							if (old) {
								var opened = Array.from(old.querySelectorAll('details[open]')).map(function (el) {return el.dataset.section;});
								old.outerHTML = await response.text();
								opened.forEach(function (key) {var el = document.querySelector('#library-status details[data-section="' + key + '"]'); if (el) el.open = true;});
							}
						} catch (error) {
							var notice = document.getElementById('library-connection');
							if (notice) notice.textContent = 'Live status could not refresh. Check the Pi connection, then reload this page.';
						} finally {pending = false;}
					}, 3000);
				})();
			</script>
		}
		<section class="rounded-2xl border border-white/10 bg-zinc-900/50 p-8">
			<p class="font-mono text-xs uppercase tracking-[0.2em] text-amber-400">Settings</p>
			<h1 class="mt-2 text-2xl font-bold">Knobs</h1>

			if vm.SavedMessage != "" {
				<div class="mt-4 rounded-lg border border-emerald-500/40 bg-emerald-950/30 px-4 py-2 text-sm text-emerald-200">{ vm.SavedMessage }</div>
			}

			<form method="POST" action="/settings/save" class="mt-6 space-y-6" data-testid="settings-form">
				<p class="text-xs text-zinc-500">Commercial scheduling moved to its own <a href="/commercials" class="text-amber-400 hover:underline">Commercials</a> page — like a real broadcast programmer.</p>

				<div>
					<label class="block text-xs uppercase tracking-wide text-zinc-400">Loop guard threshold</label>
					<p class="text-xs text-zinc-500">Warn if any episode plays more than this many times in 24h. The original DVD-loop problem.</p>
					<input
						type="number" min="1" max="20"
						name="loop_threshold"
						value={ intStr(vm.LoopGuardThreshold) }
						disabled?={ vm.Locked }
						data-testid="loop-threshold"
						class="mt-2 w-32 rounded-md border border-white/10 bg-zinc-950 px-3 py-2 font-mono text-sm"
					/>
				</div>

				<div>
					<label class="block text-xs uppercase tracking-wide text-zinc-400">Outbound webhooks</label>
					<p class="text-xs text-zinc-500">One URL per line. Fired on play / pause / skip / button-press events.</p>
					<textarea
						name="webhook_outbound"
						rows="4"
						disabled?={ vm.Locked }
						data-testid="webhook-outbound"
						class="mt-2 w-full rounded-md border border-white/10 bg-zinc-950 px-3 py-2 font-mono text-xs"
					>{ strings.Join(vm.WebhookOutbound, "\n") }</textarea>
				</div>

				<div class="rounded-lg border border-white/10 bg-zinc-950/40 p-4">
					<label class="flex items-center gap-3">
						<input type="checkbox" name="quiet_mode_enabled" value="1" checked?={ vm.QuietModeEnabled } disabled?={ vm.Locked } class="h-4 w-4" data-testid="quiet-mode-enabled"/>
						<span class="font-semibold">Quiet mode</span>
					</label>
					<p class="mt-1 text-xs text-zinc-500">Mute HDMI audio during these local hours; video playback continues.</p>
					<div class="mt-3 grid grid-cols-2 gap-3">
						<label><span class="block text-xs uppercase tracking-wide text-zinc-400">Mute from</span><input type="time" name="quiet_start" value={ vm.QuietStart } disabled?={ vm.Locked } class="mt-1 w-full rounded-md border border-white/10 bg-zinc-950 px-3 py-2 font-mono text-sm"/></label>
						<label><span class="block text-xs uppercase tracking-wide text-zinc-400">Unmute at</span><input type="time" name="quiet_end" value={ vm.QuietEnd } disabled?={ vm.Locked } class="mt-1 w-full rounded-md border border-white/10 bg-zinc-950 px-3 py-2 font-mono text-sm"/></label>
					</div>
				</div>

				<button class="btn btn-primary" disabled?={ vm.Locked } data-testid="save-settings">Save settings</button>
			</form>
		</section>

		<section class="rounded-2xl border border-white/10 bg-zinc-900/50 p-8">
			<p class="font-mono text-xs uppercase tracking-[0.2em] text-amber-400">Account</p>
			<form method="POST" action="/logout" class="mt-4">
				<button class="btn btn-ghost">Sign out</button>
			</form>
			<form method="POST" action="/change-password-form" class="mt-2">
				<a href="/change-password" class="btn btn-ghost">Change password</a>
			</form>
		</section>
	</div>
}
