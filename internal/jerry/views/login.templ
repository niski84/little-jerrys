package views

type LoginVM struct {
	Error string
	User  string // repopulate username field after a failed attempt
}

templ Login(vm LoginVM) {
	@LayoutNoNav("Little Jersey's — Sign in", loginBody(vm))
}

templ loginBody(vm LoginVM) {
	<div class="mx-auto max-w-md">
		<section class="rounded-2xl border border-white/10 bg-zinc-900/60 p-8">
			<p class="font-mono text-xs uppercase tracking-[0.2em] text-amber-400">Smash Deck</p>
			<h1 class="mt-2 text-2xl font-bold">Sign in</h1>
			<p class="mt-1 text-sm text-zinc-400">Default credentials are <code class="text-amber-300">admin</code> / <code class="text-amber-300">admin</code>. You will be required to change them on first login.</p>

			if vm.Error != "" {
				<div class="mt-4 flex items-center gap-3 rounded-lg border border-rose-500 bg-rose-950 px-4 py-3 text-sm font-semibold text-rose-100" role="alert" data-testid="login-error">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-rose-400" viewBox="0 0 20 20" fill="currentColor">
						<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
					</svg>
					{ vm.Error }
				</div>
			}

			<form method="POST" action="/login" class="mt-6 space-y-4" data-testid="login-form">
				<div>
					<label class="block text-xs uppercase tracking-wide text-zinc-400">Username</label>
					if vm.Error != "" {
						<input name="user" type="text" autocomplete="username" required value={ vm.User } data-testid="login-user" class="mt-1 w-full rounded-md border border-rose-500 bg-zinc-950 px-3 py-2 text-sm"/>
					} else {
						<input name="user" type="text" autocomplete="username" required data-testid="login-user" class="mt-1 w-full rounded-md border border-white/10 bg-zinc-950 px-3 py-2 text-sm"/>
					}
				</div>
				<div>
					<label class="block text-xs uppercase tracking-wide text-zinc-400">Password</label>
					if vm.Error != "" {
						<input name="password" type="password" autocomplete="current-password" required data-testid="login-password" class="mt-1 w-full rounded-md border border-rose-500 bg-zinc-950 px-3 py-2 text-sm" autofocus/>
					} else {
						<input name="password" type="password" autocomplete="current-password" required data-testid="login-password" class="mt-1 w-full rounded-md border border-white/10 bg-zinc-950 px-3 py-2 text-sm"/>
					}
				</div>
				<button type="submit" class="btn btn-primary w-full" data-testid="login-submit">Sign in</button>
			</form>
		</section>
	</div>
}

type ChangePasswordVM struct {
	Error string
}

templ ChangePassword(vm ChangePasswordVM) {
	@LayoutNoNav("Little Jerry's — Change password", changePasswordBody(vm))
}

templ changePasswordBody(vm ChangePasswordVM) {
	<div class="mx-auto max-w-md">
		<section class="rounded-2xl border border-amber-500/30 bg-amber-950/20 p-8">
			<p class="font-mono text-xs uppercase tracking-[0.2em] text-amber-400">Security checkpoint</p>
			<h1 class="mt-2 text-2xl font-bold">Change the default password</h1>
			<p class="mt-1 text-sm text-zinc-300">Playback controls stay locked until the default password is replaced. Pick something only you and Tony know.</p>

			if vm.Error != "" {
				<div class="mt-4 flex items-center gap-3 rounded-lg border border-rose-500 bg-rose-950 px-4 py-3 text-sm font-semibold text-rose-100" role="alert">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-rose-400" viewBox="0 0 20 20" fill="currentColor">
						<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
					</svg>
					{ vm.Error }
				</div>
			}

			<form method="POST" action="/change-password" class="mt-6 space-y-4" data-testid="change-password-form">
				<div>
					<label class="block text-xs uppercase tracking-wide text-zinc-400">New password (min 8 chars)</label>
					<input name="password" type="password" autocomplete="new-password" required minlength="8" data-testid="new-password" class="mt-1 w-full rounded-md border border-white/10 bg-zinc-950 px-3 py-2 text-sm"/>
				</div>
				<div>
					<label class="block text-xs uppercase tracking-wide text-zinc-400">Confirm</label>
					<input name="confirm" type="password" autocomplete="new-password" required minlength="8" data-testid="confirm-password" class="mt-1 w-full rounded-md border border-white/10 bg-zinc-950 px-3 py-2 text-sm"/>
				</div>
				<button type="submit" class="btn btn-primary w-full" data-testid="change-password-submit">Save and unlock controls</button>
			</form>
		</section>
	</div>
}
