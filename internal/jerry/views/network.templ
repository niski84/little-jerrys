package views

import "strconv"

type NetworkVM struct {
	Available    bool     // nmcli on PATH
	HasInternet  bool     // currently online
	APMode       bool     // currently broadcasting LittleJerrys_Config
	APssid       string   // SSID name to display
	APaddress    string   // captive portal address (192.168.42.1)
	LANAddresses []string // actual IPs across all live interfaces
	Networks     []ScannedNetwork
	ScanError    string
	JoinError    string
	JoinSuccess  string
	Locked       bool
}

type ScannedNetwork struct {
	SSID   string
	Signal int
	InUse  bool
}

templ Network(vm NetworkVM) {
	@Layout("Little Jerry's — Network", networkBody(vm))
}

templ networkBody(vm NetworkVM) {
	<div class="grid grid-cols-1 gap-6">
		<section class="rounded-2xl border border-white/10 bg-zinc-900/50 p-8">
			<p class="font-mono text-xs uppercase tracking-[0.2em] text-amber-400">Network</p>
			<h1 class="mt-2 text-2xl font-bold">Connectivity</h1>

			<dl class="mt-6 grid grid-cols-1 gap-3 text-sm md:grid-cols-3">
				<div class="rounded-lg border border-white/10 bg-zinc-950/40 px-4 py-3">
					<dt class="text-xs uppercase tracking-wide text-zinc-400">NetworkManager</dt>
					<dd class="mt-1 font-mono" data-testid="network-available">
						if vm.Available {
							<span class="text-emerald-400">available</span>
						} else {
							<span class="text-zinc-500">unavailable (dev)</span>
						}
					</dd>
				</div>
				<div class="rounded-lg border border-white/10 bg-zinc-950/40 px-4 py-3">
					<dt class="text-xs uppercase tracking-wide text-zinc-400">Internet</dt>
					<dd class="mt-1 font-mono" data-testid="network-internet">
						if vm.HasInternet {
							<span class="text-emerald-400">online</span>
						} else {
							<span class="text-rose-400">offline</span>
						}
					</dd>
				</div>
				<div class="rounded-lg border border-white/10 bg-zinc-950/40 px-4 py-3">
					<dt class="text-xs uppercase tracking-wide text-zinc-400">AP mode</dt>
					<dd class="mt-1 font-mono" data-testid="network-ap-mode">
						if vm.APMode {
							<span class="text-amber-400">broadcasting { vm.APssid }</span>
						} else {
							<span class="text-zinc-500">off</span>
						}
					</dd>
				</div>
			</dl>

			if !vm.Available {
				<p class="mt-6 rounded-lg border border-amber-500/30 bg-amber-950/20 px-4 py-3 text-sm text-amber-200">
					You're running on a dev machine without NetworkManager. The Pi handles real WiFi switching — this page won't have networks to scan here.
				</p>
			}

			if len(vm.LANAddresses) > 0 || vm.APMode {
				<div class="mt-6 rounded-lg border border-amber-300 bg-amber-50 px-4 py-3 dark:border-amber-500/30 dark:bg-amber-950/20" data-testid="reachable-at">
					<p class="font-mono text-xs uppercase tracking-wider text-amber-700 dark:text-amber-300">Reach this Pi at</p>
					<ul class="mt-2 space-y-1 font-mono text-sm">
						if vm.APMode {
							<li><a href={ templ.SafeURL("http://" + vm.APaddress) } class="text-amber-700 hover:underline dark:text-amber-300">http://{ vm.APaddress }</a> <span class="text-xs text-zinc-500">(captive portal AP)</span></li>
						}
						for _, ip := range vm.LANAddresses {
							<li><a href={ templ.SafeURL("http://" + ip + ":8089") } class="text-amber-700 hover:underline dark:text-amber-300">http://{ ip }:8089</a></li>
						}
					</ul>
					<p class="mt-2 text-xs text-zinc-500 dark:text-zinc-400">Bookmark whichever address staff will use most.</p>
				</div>
			}
		</section>

		if vm.JoinError != "" {
			<div class="rounded-lg border border-rose-500/40 bg-rose-950/40 px-4 py-3 text-sm text-rose-200" data-testid="join-error">
				Couldn't join: { vm.JoinError }
			</div>
		}
		if vm.JoinSuccess != "" {
			<div class="rounded-lg border border-emerald-500/40 bg-emerald-950/30 px-4 py-3 text-sm text-emerald-200" data-testid="join-success">
				{ vm.JoinSuccess }
			</div>
		}

		<section class="rounded-2xl border border-white/10 bg-zinc-900/50 p-8">
			<div class="flex items-baseline justify-between">
				<h2 class="text-xl font-bold">Available networks</h2>
				<form method="POST" action="/network/scan">
					<button class="btn btn-ghost btn-sm" disabled?={ !vm.Available || vm.Locked } data-testid="btn-scan">Rescan</button>
				</form>
			</div>

			if vm.ScanError != "" {
				<p class="mt-3 text-sm text-rose-300">{ vm.ScanError }</p>
			}

			if len(vm.Networks) == 0 && vm.Available {
				<p class="mt-4 text-sm text-zinc-500">No networks visible yet — hit Rescan.</p>
			}

			if len(vm.Networks) > 0 {
				<form method="POST" action="/network/join" class="mt-4 space-y-3" data-testid="join-form">
					<div class="rounded-lg border border-white/10 bg-zinc-950/40">
						for i, n := range vm.Networks {
							<label class={ "flex cursor-pointer items-center justify-between gap-4 px-4 py-3",
								templ.KV("border-t border-white/5", i > 0) }>
								<div class="flex items-center gap-3">
									<input type="radio" name="ssid" value={ n.SSID } required class="h-4 w-4"/>
									<span class="font-mono text-sm">{ n.SSID }</span>
									if n.InUse {
										<span class="rounded bg-emerald-500/20 px-2 py-0.5 text-xs text-emerald-300">connected</span>
									}
								</div>
								<span class="font-mono text-xs text-zinc-500">{ strconv.Itoa(n.Signal) }%</span>
							</label>
						}
					</div>
					<div>
						<label class="block text-xs uppercase tracking-wide text-zinc-400">Password</label>
						<input
							name="password" type="password" autocomplete="off"
							placeholder="(leave blank for open networks)"
							disabled?={ vm.Locked }
							data-testid="join-password"
							class="mt-1 w-full rounded-md border border-white/10 bg-zinc-950 px-3 py-2 font-mono text-sm"
						/>
					</div>
					<button class="btn btn-primary" disabled?={ vm.Locked } data-testid="btn-join">Join network</button>
				</form>
			}
		</section>

		<section class="rounded-2xl border border-white/10 bg-zinc-900/50 p-8">
			<p class="font-mono text-xs uppercase tracking-[0.2em] text-amber-400">Captive portal</p>
			<h2 class="mt-2 text-xl font-bold">AP mode controls</h2>
			<p class="mt-1 text-sm text-zinc-400">
				When the restaurant WiFi is unavailable, the Pi broadcasts its own network
				(<code class="text-amber-300">{ vm.APssid }</code>) so staff can connect from a phone
				and configure things from <code class="text-amber-300">192.168.4.1</code>.
			</p>
			<div class="mt-4 flex gap-3">
				<form method="POST" action="/network/ap/start">
					<button class="btn" disabled?={ !vm.Available || vm.Locked || vm.APMode } data-testid="btn-ap-start">Start AP</button>
				</form>
				<form method="POST" action="/network/ap/stop">
					<button class="btn btn-ghost" disabled?={ !vm.Available || vm.Locked || !vm.APMode } data-testid="btn-ap-stop">Stop AP</button>
				</form>
			</div>
		</section>
	</div>
}
