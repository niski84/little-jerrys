package views

import (
	"fmt"
	"path/filepath"
	"strconv"

	"github.com/niski84/little-jerrys/internal/player"
	"github.com/niski84/little-jerrys/internal/playlist"
)

// DashboardVM is the view model for the now-playing page.
type DashboardVM struct {
	NowPlaying      player.Status
	Stats           playlist.Stats
	LoopHot         []string
	PositionSeconds float64
	Queue           []QueueRow

	// Per-episode metadata. Episode title / synopsis / image come from TMDB
	// (cached on USB). Empty fields render as "—" — the page degrades fine
	// without metadata.
	NowTitle    string
	NowSynopsis string
	NowImageURL string

	// Cumulative play counts keyed by file path.
	PlayCounts map[string]int
}

// QueueRow is one row in the visible playlist editor. Index is the row's
// position in the live queue — used by the skip/reorder endpoints.
type QueueRow struct {
	Index          int
	Path           string
	Label          string  // friendly label (TMDB title if known, else basename)
	IsCommercial   bool
	EstSecs        float64
	PlayCount      int // raw "started" count (incremented on every load)
	CompletedCount int // "actually watched" count (75% threshold)
}

templ Dashboard(vm DashboardVM) {
	@Layout("Little Jerry's — Now Playing", dashboardBody(vm))
}

// updateBanner polls /api/update/status every 30s and shows a countdown
// banner when a maintenance restart is pending.
templ UpdateBanner() {
	<div
		id="update-banner"
		class="hidden mb-4 rounded-lg border border-amber-500/40 bg-amber-950/60 px-4 py-3 text-amber-200 text-sm"
		hx-get="/api/update/status"
		hx-trigger="load, every 30s"
		hx-swap="none"
		x-data="updateBanner()"
		x-init="poll()"
	>
		<div class="flex items-start gap-3">
			<span class="mt-0.5 text-amber-400">⚠</span>
			<div class="flex-1">
				<p class="font-semibold">Maintenance restart scheduled</p>
				<p class="mt-0.5 opacity-80">
					Little Jerry's <span x-text="version"></span> is ready.
					Restarting in <span x-text="countdown" class="font-mono font-bold"></span>.
					<a :href="releaseURL" target="_blank" rel="noopener" class="underline ml-1">See what's new</a>
				</p>
			</div>
		</div>
	</div>
	<script>
	function updateBanner() {
		return {
			version: '',
			releaseURL: '#',
			applyAt: null,
			countdown: '',
			_timer: null,
			poll() {
				fetch('/api/update/status')
					.then(r => r.status === 204 ? null : r.json())
					.then(data => {
						if (!data) { this._hide(); return; }
						this.version = data.version;
						this.releaseURL = data.release_url || '#';
						this.applyAt = new Date(data.apply_at);
						this._show();
						this._startCountdown();
					})
					.catch(() => {});
				// re-poll every 30s
				setTimeout(() => this.poll(), 30000);
			},
			_startCountdown() {
				if (this._timer) clearInterval(this._timer);
				this._timer = setInterval(() => {
					const secs = Math.max(0, Math.round((this.applyAt - Date.now()) / 1000));
					if (secs <= 0) { this.countdown = 'now'; clearInterval(this._timer); return; }
					const m = Math.floor(secs / 60), s = secs % 60;
					this.countdown = m > 0 ? `${m}m ${s}s` : `${s}s`;
				}, 1000);
			},
			_show() { document.getElementById('update-banner').classList.remove('hidden'); },
			_hide() { document.getElementById('update-banner').classList.add('hidden'); },
		}
	}
	</script>
}

templ dashboardBody(vm DashboardVM) {
	@UpdateBanner()
	<div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
		<!-- Now Playing hero — broadcast title-card treatment -->
		<section class="lg:col-span-2 dashboard-hero">
			<div class="lower-third -mx-6 -mt-6 mb-5">
				<span class="label">On Air · Now Playing</span>
				<span class="data" data-testid="lt-title">
					if vm.NowTitle != "" {
						{ vm.NowTitle }
					} else if vm.NowPlaying.NowPlaying != "" {
						{ filepath.Base(vm.NowPlaying.NowPlaying) }
					} else {
						— off air —
					}
				</span>
			</div>
			<div class="mt-4 grid grid-cols-1 gap-6 md:grid-cols-[14rem_1fr]">
				<div class="w-full md:w-56">
					<div class="aspect-video w-full overflow-hidden rounded-lg border border-zinc-200 bg-black dark:border-white/10">
						if vm.NowPlaying.NowPlaying != "" {
							<video
								id="now-video"
								data-testid="now-video"
								class="h-full w-full bg-black"
								src="/api/now/preview"
								if vm.NowImageURL != "" { poster={ vm.NowImageURL } }
								controls
								autoplay
								muted
								preload="auto"
								playsinline
							>your browser doesn't support inline video</video>
						} else if vm.NowImageURL != "" {
							<img src={ vm.NowImageURL } alt={ vm.NowTitle } class="h-full w-full object-cover" data-testid="now-image"/>
						} else {
							<div class="flex h-full items-center justify-center font-mono text-xs text-zinc-400 dark:text-zinc-600" data-testid="now-image-placeholder">nothing loaded</div>
						}
					</div>
					<p class="mt-1 text-center font-mono text-[10px] text-zinc-500 dark:text-zinc-400">
						<span class="inline-block h-1.5 w-1.5 animate-pulse rounded-full bg-rose-500"></span>
						live preview · mirrors HDMI · muted by default
					</p>
				</div>
				<div class="min-w-0">
					<h1 class="break-all text-2xl font-bold" data-testid="now-playing">
						if vm.NowTitle != "" {
							{ vm.NowTitle }
						} else if vm.NowPlaying.NowPlaying != "" {
							{ filepath.Base(vm.NowPlaying.NowPlaying) }
						} else {
							— nothing yet —
						}
					</h1>
					<p id="live-paused" class="mt-1 text-sm text-rose-500 dark:text-rose-400" style={ pausedStyle(vm.NowPlaying.Paused) } data-testid="live-paused">Paused</p>
					if vm.NowSynopsis != "" {
						<p class="mt-3 text-sm leading-relaxed text-zinc-700 dark:text-zinc-300" data-testid="now-synopsis">{ vm.NowSynopsis }</p>
					}

					<!-- Live transport: position / duration with a click-to-seek bar.
					     Updated every 1s by the polling script below the section. -->
					<div class="mt-5" data-testid="transport">
						<div class="flex items-baseline justify-between font-mono text-[11px] text-zinc-600 dark:text-zinc-300">
							<span id="live-position" data-testid="live-position">{ fmtPosition(vm.PositionSeconds) }</span>
							<span class="text-zinc-400 dark:text-zinc-500"><span id="live-mode" data-testid="live-mode">{ "—" }</span></span>
							<span id="live-duration" data-testid="live-duration">—</span>
						</div>
						<div
							id="seek-bar"
							class="mt-1 h-2 cursor-pointer rounded-full bg-zinc-200 dark:bg-zinc-800"
							title="Click to seek"
							data-testid="seek-bar"
						>
							<div id="seek-fill" class="h-2 rounded-full bg-amber-500 transition-[width] duration-300 dark:bg-amber-400" style="width:0%"></div>
						</div>
					</div>

					<div class="mt-6 flex flex-wrap gap-3">
						<button class="btn btn-primary" hx-post="/api/play" hx-swap="none" data-testid="btn-play">Play</button>
						<button class="btn" hx-post="/api/pause" hx-swap="none" data-testid="btn-pause">Pause</button>
						<button class="btn btn-warning" hx-post="/api/skip" hx-swap="none" data-testid="btn-skip">Skip (Bailout)</button>
						<button class="btn btn-ghost btn-sm" data-seek="-30" data-testid="btn-seek-back-30">−30s</button>
						<button class="btn btn-ghost btn-sm" data-seek="-10" data-testid="btn-seek-back-10">−10s</button>
						<button class="btn btn-ghost btn-sm" data-seek="10" data-testid="btn-seek-fwd-10">+10s</button>
						<button class="btn btn-ghost btn-sm" data-seek="30" data-testid="btn-seek-fwd-30">+30s</button>
						<button class="btn btn-ghost" hx-post="/api/button/press" hx-swap="none" data-testid="btn-simulate-gpio">Simulate GPIO</button>
					</div>
				</div>
			</div>
		</section>

		<!-- Catalog stats -->
		<aside class="rounded-2xl border border-zinc-200 bg-white/85 p-6 dark:border-white/10 dark:bg-zinc-900/55">
			<p class="font-mono text-xs uppercase tracking-[0.2em] text-amber-500 dark:text-amber-400">Catalog</p>
			<dl class="mt-4 space-y-3 text-sm">
				<div class="flex justify-between"><dt class="text-zinc-500 dark:text-zinc-400">Episodes</dt><dd class="font-mono">{ strconv.Itoa(vm.Stats.TotalEpisodes) }</dd></div>
				<div class="flex justify-between"><dt class="text-zinc-500 dark:text-zinc-400">Blacklisted</dt><dd class="font-mono">{ strconv.Itoa(vm.Stats.BlacklistedCount) }</dd></div>
				<div class="flex justify-between"><dt class="text-zinc-500 dark:text-zinc-400">Weighted</dt><dd class="font-mono">{ strconv.Itoa(vm.Stats.WeightedCount) }</dd></div>
				<div class="flex justify-between"><dt class="text-zinc-500 dark:text-zinc-400">Queue remaining</dt><dd class="font-mono" data-testid="queue-remaining">{ strconv.Itoa(vm.Stats.QueueRemaining) }</dd></div>
				<div class="flex justify-between">
					<dt class="text-zinc-500 dark:text-zinc-400">Commercials</dt>
					<dd class="font-mono">
						if vm.Stats.CommercialsEnabled {
							<span class="text-emerald-600 dark:text-emerald-400">on</span>
						} else {
							<span class="text-zinc-500">off</span>
						}
						· { strconv.Itoa(vm.Stats.CommercialsLoaded) } loaded
					</dd>
				</div>
			</dl>
		</aside>

		<!-- Up-Next playlist editor -->
		<section class="lg:col-span-3 rounded-2xl border border-zinc-200 bg-white/85 p-8 dark:border-white/10 dark:bg-zinc-900/55">
			<div class="flex items-center justify-between gap-4">
				<div>
					<p class="font-mono text-xs uppercase tracking-[0.2em] text-amber-500 dark:text-amber-400">Up next</p>
					<h2 class="mt-1 text-xl font-bold">Playlist</h2>
				</div>
				<form method="POST" action="/api/queue/regenerate" hx-post="/api/queue/regenerate" hx-on::after-request="window.location.reload()">
					<button class="btn btn-warning btn-sm" data-testid="btn-regenerate">Regenerate (apply weights)</button>
				</form>
			</div>

			if len(vm.Queue) == 0 {
				<p class="mt-6 rounded-lg border border-dashed border-zinc-300 px-4 py-6 text-center text-sm text-zinc-500 dark:border-white/10" data-testid="queue-empty">
					Queue is empty. Hit Regenerate.
				</p>
			} else {
				<ol
					id="queue-list"
					class="mt-6 space-y-1"
					data-testid="queue-list"
					x-data="queueSortable()"
					x-init="init($el)"
				>
					for _, row := range vm.Queue {
						@QueueRowView(row)
					}
				</ol>
				<p class="mt-3 text-xs text-zinc-500 dark:text-zinc-500">Drag to reorder · click ✕ to remove an item · breaks show estimated seconds</p>
			}
		</section>

		if len(vm.LoopHot) > 0 {
			<section class="lg:col-span-3 rounded-2xl border border-rose-500/40 bg-rose-50 p-6 dark:bg-rose-950/30" data-testid="loop-guard">
				<p class="font-mono text-xs uppercase tracking-[0.2em] text-rose-600 dark:text-rose-300">Loop Guard</p>
				<p class="mt-2 text-sm text-rose-800 dark:text-rose-200">
					These episodes have played more than the threshold in the last 24 hours.
					This is the original DVD-loop problem — investigate before it gets worse.
				</p>
				<ul class="mt-3 space-y-1 font-mono text-xs text-rose-900 dark:text-rose-100">
					for _, p := range vm.LoopHot {
						<li>{ filepath.Base(p) }</li>
					}
				</ul>
			</section>
		}
	</div>

	<!-- Sortable.js: lightweight drag library, works on touch devices. -->
	<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
	<script>
		function queueSortable() {
			return {
				init(el) {
					Sortable.create(el, {
						animation: 150,
						handle: '.queue-handle',
						onEnd: (e) => {
							if (e.oldIndex === e.newIndex) return;
							fetch('/api/queue/reorder', {
								method: 'POST',
								headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
								body: new URLSearchParams({ from: e.oldIndex, to: e.newIndex }),
							}).then(() => window.location.reload());
						},
					});
				},
			};
		}
	</script>

	<!-- Live transport: poll /api/status every 1s + click-to-seek bar. -->
	<script>
		(function () {
			let lastDuration = 0;
			let lastFile = null;

			function fmtTime(s) {
				if (!isFinite(s) || s < 0) s = 0;
				const m = Math.floor(s / 60);
				const r = Math.floor(s % 60);
				return m + ':' + (r < 10 ? '0' : '') + r;
			}
			async function tick() {
				try {
					const res = await fetch('/api/status', { headers: { 'Accept': 'application/json' } });
					if (!res.ok) return;
					const s = await res.json();
					document.getElementById('live-position').textContent = fmtTime(s.position_secs);
					document.getElementById('live-duration').textContent = fmtTime(s.duration_secs);
					document.getElementById('live-mode').textContent = s.mode || '—';
					document.getElementById('live-paused').style.display = s.paused ? '' : 'none';
					lastDuration = s.duration_secs || 0;
					const pct = lastDuration > 0 ? Math.max(0, Math.min(100, 100 * s.position_secs / lastDuration)) : 0;
					document.getElementById('seek-fill').style.width = pct + '%';
					// File change: swap the video src in place (no page reload).
					// Cache-bust with a query param so the browser refetches.
					const v = document.getElementById('now-video');
					if (lastFile !== null && s.now_filename && s.now_filename !== lastFile) {
						if (v) {
							v.src = '/api/now/preview?t=' + Date.now();
							v.load();
							// Match mpv's pause/play state on the new file.
							if (!s.paused) v.play().catch(function(){});
						}
						const title = document.querySelector('[data-testid="now-playing"]');
						if (title && s.now_filename) {
							title.textContent = s.now_title || s.now_filename;
						}
					}
					lastFile = s.now_filename;
					// Mirror mpv pause/play state onto the preview <video>.
					// Without this, the preview keeps streaming when staff
					// pauses the TV (and vice versa), which made the controls
					// feel disconnected.
					if (v && v.readyState >= 2) {
						if (s.paused && !v.paused) {
							v.pause();
						} else if (!s.paused && v.paused) {
							v.play().catch(function(){});
						}
						// Resync currentTime if the preview has drifted more
						// than 2s from mpv (user scrubbed the preview, or
						// network buffered ahead). Threshold is wide enough
						// that decoder jitter doesn't cause visible jumps.
						if (lastDuration > 0 && Math.abs(v.currentTime - s.position_secs) > 2) {
							try { v.currentTime = s.position_secs; } catch (e) {}
						}
					}
				} catch (e) { /* network blip; try again next tick */ }
			}

			// Click-to-seek on the bar.
			const bar = document.getElementById('seek-bar');
			if (bar) {
				bar.addEventListener('click', function (ev) {
					if (!lastDuration) return;
					const rect = bar.getBoundingClientRect();
					const ratio = (ev.clientX - rect.left) / rect.width;
					const target = Math.max(0, ratio * lastDuration);
					fetch('/api/seek', {
						method: 'POST',
						headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
						body: new URLSearchParams({ secs: target.toFixed(1) }),
					}).then(tick);
				});
			}

			// Relative-seek buttons: ±10s / ±30s.
			document.querySelectorAll('button[data-seek]').forEach(function (btn) {
				btn.addEventListener('click', async function () {
					const delta = parseFloat(btn.dataset.seek || '0');
					try {
						const r = await fetch('/api/status').then(r => r.json());
						const target = Math.max(0, (r.position_secs || 0) + delta);
						await fetch('/api/seek', {
							method: 'POST',
							headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
							body: new URLSearchParams({ secs: target.toFixed(1) }),
						});
						tick();
					} catch (e) { /* ignore */ }
				});
			});

			tick();
			setInterval(tick, 1000);
		})();
	</script>
}

// QueueRowView is one entry in the playlist editor list. Exported so it can
// be re-rendered as an HTMX fragment if we want partial swaps later.
templ QueueRowView(row QueueRow) {
	<li
		class={ "flex items-center justify-between gap-3 rounded-md border px-3 py-2 text-sm",
			templ.KV("border-amber-300 bg-amber-50 dark:border-amber-500/30 dark:bg-amber-950/20", row.IsCommercial),
			templ.KV("border-zinc-200 bg-zinc-50 dark:border-white/10 dark:bg-zinc-950/40", !row.IsCommercial) }
		data-testid={ "queue-row-" + strconv.Itoa(row.Index) }
		data-index={ strconv.Itoa(row.Index) }
	>
		<button
			class="queue-handle cursor-grab select-none text-zinc-400 hover:text-zinc-600 dark:hover:text-zinc-200"
			title="Drag to reorder"
			aria-label="Drag handle"
		>⋮⋮</button>
		<div class="min-w-0 flex-1">
			if row.IsCommercial {
				<p class="font-mono text-xs"><span class="rounded bg-amber-500/20 px-2 py-0.5 text-[10px] uppercase tracking-wider text-amber-700 dark:text-amber-300">break</span> { row.Label }</p>
			} else {
				<p class="truncate font-mono text-xs text-zinc-700 dark:text-zinc-200">{ row.Label }</p>
			}
			<p class="font-mono text-[11px] text-zinc-500">
				~{ fmtSecs(row.EstSecs) }
				if !row.IsCommercial && row.CompletedCount > 0 {
					· watched { strconv.Itoa(row.CompletedCount) }×
					if row.PlayCount > row.CompletedCount {
						<span class="text-zinc-400 dark:text-zinc-500">(started { strconv.Itoa(row.PlayCount) })</span>
					}
				} else if !row.IsCommercial && row.PlayCount > 0 {
					· started { strconv.Itoa(row.PlayCount) }×
				}
			</p>
		</div>
		<form method="POST" action="/api/queue/remove" hx-post="/api/queue/remove" hx-on::after-request="window.location.reload()" class="inline-flex">
			<input type="hidden" name="index" value={ strconv.Itoa(row.Index) }/>
			if row.IsCommercial {
				<button class="btn btn-ghost btn-sm" data-testid={ "btn-skip-commercial-" + strconv.Itoa(row.Index) } title="Skip this commercial">Skip</button>
			} else {
				<button class="btn btn-ghost btn-sm" data-testid={ "btn-remove-episode-" + strconv.Itoa(row.Index) } title="Remove from queue">✕</button>
			}
		</form>
	</li>
}

// fmtSecs formats a duration in seconds as "M:SS".
func fmtSecs(s float64) string {
	if s < 0 {
		s = 0
	}
	total := int(s + 0.5)
	mins := total / 60
	secs := total % 60
	return fmt.Sprintf("%d:%02d", mins, secs)
}
