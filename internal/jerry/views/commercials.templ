package views

import "path/filepath"

type CommercialsVM struct {
	Catalog             []string
	Blocked             map[string]bool
	Weights             map[string]int
	Enabled             bool
	BreakAfterMinutes   int
	CommercialsPerBreak int
	Locked              bool
	SavedMessage        string
}

templ Commercials(vm CommercialsVM) {
	@Layout("Little Jerry's — Commercial Break Scheduler", commercialsBody(vm))
}

templ commercialsBody(vm CommercialsVM) {
	<div class="grid grid-cols-1 gap-6">
		<section class="rounded-2xl border border-amber-500/30 bg-amber-950/10 p-8">
			<p class="font-mono text-xs uppercase tracking-[0.2em] text-amber-400">Broadcast Programmer</p>
			<h1 class="mt-2 text-2xl font-bold">Commercial breaks — schedule</h1>
			<p class="mt-1 text-sm text-zinc-400">
				Pretend you're at a 90s broadcast station. Set how often the network cuts to
				ads and how many run back-to-back. Episode runtime is tracked via ffprobe;
				once accumulated playtime hits the threshold, a break fires before the next
				episode starts.
			</p>

			if vm.SavedMessage != "" {
				<div class="mt-4 rounded-lg border border-emerald-500/40 bg-emerald-950/30 px-4 py-2 text-sm text-emerald-200" data-testid="commercials-saved">{ vm.SavedMessage }</div>
			}

			<form method="POST" action="/commercials/schedule" class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-3">
				<label class="md:col-span-1">
					<span class="block text-xs uppercase tracking-wide text-zinc-400">Commercials enabled</span>
					<div class="mt-2 flex items-center gap-3">
						<input
							type="checkbox" name="enabled" value="1"
							checked?={ vm.Enabled }
							disabled?={ vm.Locked }
							data-testid="commercials-enabled"
							class="h-5 w-5"
						/>
						<span class="text-sm">
							if vm.Enabled {
								<span class="text-emerald-400">on the air</span>
							} else {
								<span class="text-zinc-500">off — episodes only</span>
							}
						</span>
					</div>
				</label>
				<label>
					<span class="block text-xs uppercase tracking-wide text-zinc-400">Break every (minutes of episode time)</span>
					<input
						type="number" min="5" max="60"
						name="break_after"
						value={ intStr(vm.BreakAfterMinutes) }
						disabled?={ vm.Locked }
						data-testid="break-after-minutes"
						class="mt-2 w-full rounded-md border border-white/10 bg-zinc-950 px-3 py-2 font-mono text-sm"
					/>
				</label>
				<label>
					<span class="block text-xs uppercase tracking-wide text-zinc-400">Commercials per break</span>
					<input
						type="number" min="1" max="10"
						name="per_break"
						value={ intStr(vm.CommercialsPerBreak) }
						disabled?={ vm.Locked }
						data-testid="commercials-per-break"
						class="mt-2 w-full rounded-md border border-white/10 bg-zinc-950 px-3 py-2 font-mono text-sm"
					/>
				</label>
				<div class="md:col-span-3">
					<button class="btn btn-primary" disabled?={ vm.Locked } data-testid="save-commercial-schedule">Save schedule</button>
				</div>
			</form>
		</section>

		<section class="rounded-2xl border border-white/10 bg-zinc-900/50 p-8">
			<p class="font-mono text-xs uppercase tracking-[0.2em] text-amber-400">Commercial Library</p>
			<h2 class="mt-2 text-xl font-bold">Per-spot weights and blocks</h2>
			<p class="mt-1 text-sm text-zinc-400">
				Weight 2 = twice as likely to run. Block to take a spot off the air entirely
				(useful when a regional ad gets stale or someone complains).
			</p>

			if len(vm.Catalog) == 0 {
				<p class="mt-6 rounded-lg border border-white/10 bg-zinc-950/50 px-4 py-3 text-sm text-zinc-400">
					No commercials detected. Drop files into <code class="text-amber-300">commercials/</code> on the USB drive.
				</p>
			} else {
				<form method="POST" action="/commercials/library" class="mt-6 space-y-2" data-testid="commercial-library-form">
					for _, p := range vm.Catalog {
						<div class="flex items-center justify-between rounded-lg border border-white/10 bg-zinc-950/40 px-3 py-2">
							<div class="min-w-0 flex-1">
								<p class="truncate font-mono text-xs text-zinc-200">{ filepath.Base(p) }</p>
								<p class="truncate font-mono text-[10px] text-zinc-500">{ p }</p>
							</div>
							<div class="ml-4 flex items-center gap-3">
								<label class="text-xs text-zinc-400">weight
									<input
										type="number" min="0" max="10"
										name={ "cw:" + p }
										value={ weightStr(vm.Weights, p) }
										disabled?={ vm.Locked }
										class="ml-1 w-16 rounded-md border border-white/10 bg-zinc-950 px-2 py-1 text-right font-mono text-sm"
									/>
								</label>
								<label class="flex items-center gap-1 text-xs text-zinc-400">
									<input
										type="checkbox" name={ "cb:" + p } value="1"
										checked?={ vm.Blocked[p] }
										disabled?={ vm.Locked }
									/>
									block
								</label>
							</div>
						</div>
					}
					<div class="pt-2">
						<button class="btn btn-primary" disabled?={ vm.Locked } data-testid="save-commercial-library">Save library</button>
					</div>
				</form>
			}
		</section>
	</div>
}
