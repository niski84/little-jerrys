# Delegate removable media lifecycle to systemd-managed helpers, not udev.
ACTION=="add", SUBSYSTEM=="block", ENV{DEVTYPE}=="partition", KERNEL=="sd[a-z][0-9]*", SUBSYSTEMS=="usb", TAG+="systemd", ENV{SYSTEMD_WANTS}+="jerry-usb-mount@%k.service"
ACTION=="remove", SUBSYSTEM=="block", ENV{DEVTYPE}=="partition", KERNEL=="sd[a-z][0-9]*", SUBSYSTEMS=="usb", RUN+="/usr/bin/systemd-umount --no-block /media/usb"
