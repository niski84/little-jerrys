[connection]
id=jerry-ap
type=wifi
interface-name=wlan0
autoconnect=false
autoconnect-priority=-100

[wifi]
mode=ap
ssid=Channel14_Setup

[wifi-security]
key-mgmt=wpa-psk
proto=rsn
group=ccmp
pairwise=ccmp
psk=channel14setup

[ipv4]
method=shared
addresses=10.42.0.1/24

[ipv6]
method=ignore

[proxy]
