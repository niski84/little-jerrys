[Unit]
Description=Little Jerry's
Documentation=https://github.com/niski84/little-jerrys
After=network-online.target jerry-firstboot.service
Wants=network-online.target
Requires=jerry-firstboot.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=jerry
Group=jerry
SupplementaryGroups=video audio render
Environment=JERRY_STATE_PATH=/var/lib/jerry/state.json
Environment=JERRY_MEDIA_ROOT=/opt/jerry/media
Environment=JERRY_IMPORT_ROOT=/media/usb
Environment=JERRY_AUTO_UPDATE=false
Environment=JERRY_MPV_SOCKET=/tmp/mpv-jerry.sock
ExecStart=/opt/jerry/jerry
WorkingDirectory=/opt/jerry
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/jerry /media/usb /opt/jerry/media /tmp /run
ProtectHome=true

[Install]
WantedBy=multi-user.target
