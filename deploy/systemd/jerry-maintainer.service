[Unit]
Description=Channel Eleven exact-revision maintainer executor (opt-in)
After=network-online.target jerry.service
Requires=jerry.service

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/jerry-maintainer.env
ExecStart=/usr/local/libexec/jerry-maintainer-executor --target ${JERRY_MAINTAINER_TARGET} --device-id ${JERRY_MAINTAINER_DEVICE_ID}
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/jerry /var/lib/jerry-maintainer
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
